# ─── Database (Neon Postgres) ───
# Get your connection string from Neon dashboard or Vercel Marketplace
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ─── Auth ───
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=CHANGE_ME_generate_a_32_byte_random_secret

# ─── Admin credentials (fallback when no DATABASE_URL) ───
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_use_a_strong_unique_password

# ─── Security / alerting ───
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECURITY_SECRET=CHANGE_ME_32_byte_hex

# ─── Setup endpoint (POST /api/setup) ───
# Required header x-setup-secret. Disabled in production unless ALLOW_SETUP=true.
SETUP_SECRET=CHANGE_ME_random_secret
