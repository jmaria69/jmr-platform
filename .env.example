# ═══════════════════════════════════════════════════════
# Praxia Labs — Variables de entorno requeridas
# Copia este archivo como .env.local y rellena los valores.
# NUNCA subas .env.local al repositorio (ya esta en .gitignore).
# ═══════════════════════════════════════════════════════

# ─── Base de datos (Neon PostgreSQL) ───
# Obtener en: https://console.neon.tech/
DATABASE_URL=postgresql://user:password@ep-xxx.eu-west-1.aws.neon.tech/neondb?sslmode=require

# ─── Resend (email transaccional) ───
# Obtener en: https://resend.com/api-keys
# Dominio verificado requerido: praxialabs.com
# From address usado: noreply@praxialabs.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Autenticacion JWT ───
# Clave secreta para firmar tokens de sesion (min 32 caracteres)
# Generar con: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_generate_a_32_byte_random_secret

# ─── Admin (seed inicial) ───
# Usada por scripts/seed.dev.ts para crear el hash de contrasena del admin
# Email del admin: jmaria.romero@praxialabs.com (definido en el seed)
# Despues del primer seed puedes eliminar esta variable del .env.local
ADMIN_PASSWORD=CHANGE_ME_use_a_strong_unique_password
ADMIN_EMAIL=jmaria.romero@praxialabs.com

# ─── Seguridad ───
# Clave para firmar eventos del security-logger
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECURITY_SECRET=CHANGE_ME_32_byte_hex

# ─── Endpoint de setup ───
# Header requerido: x-setup-secret. Desactivado en produccion salvo ALLOW_SETUP=true
SETUP_SECRET=CHANGE_ME_random_secret

# ─── Google Analytics (opcional) ───
# ID de medicion GA4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ─── Cloudflare WAF events (opcional) ───
# Trae los bloqueos reales del WAF de Cloudflare (edge) al panel /admin/seguridad.
# Sin esto, el panel solo muestra eventos de proxy.ts (nivel aplicacion) y Cloudflare
# sigue bloqueando en el edge sin que el panel lo refleje.
# Mismo token/zone que usa SIAM (siem/cloudflare_firewall.py) -- scope Zone:Firewall Services:Read
# Obtener en: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=CHANGE_ME_cloudflare_api_token
CLOUDFLARE_ZONE_ID=CHANGE_ME_cloudflare_zone_id

# ─── Agente de chat (Praxia Labs / SIAM) ───
# URL del backend del agente (whatsapp-agentkit), expone POST /chat
NEXT_PUBLIC_AGENT_URL=http://127.0.0.1:8010
