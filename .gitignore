# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NUNCA subir secretos
.env
.env.local
.env.*.local
.env.development
.env.production

# databases (pueden contener hashes/datos reales)
*.db
*.db-journal
*.sqlite
*.sqlite3
prisma/dev.db

# logs
*.log
build-error.log

# windows (metadatos con ':' que rompen el checkout en Windows)
*Zone.Identifier

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code
.claude/

# generated
/src/generated/prisma
.env*

# graphify (artefacto local, 6.8M)
/graphify-out

# worktrees locales (subagent-driven-development, etc.)
/.worktrees

# serena (caché y estado local del MCP, no se comparte)
/.serena
