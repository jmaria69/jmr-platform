datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Contact {
  id        Int     @id @default(autoincrement())
  nombre    String
  email     String
  empresa   String?
  proyecto  String
  mensaje   String
  createdAt DateTime @default(now())
}