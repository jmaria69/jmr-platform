datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          String    @default("admin")
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("admin_users")
}

model HomeConfig {
  id        Int      @id @default(1)
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("home_config")
}

model Project {
  id               String    @id
  name             String
  description      String
  longDescription  String    @default("")
  tech             String[]  @default([])
  status           String    @default("development")
  category         String
  url              String?
  github           String?
  image            String
  color            String
  videoUrl         String?   @map("video_url")
  metricsUsers     Int?
  metricsRevenue   Float?
  metricsRating    Float?
  sortOrder        Int       @default(9999) @map("sort_order")
  showOnHome       Boolean   @default(false) @map("show_on_home")
  showInLab        Boolean   @default(true)  @map("show_in_lab")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("projects")
}

model ProjectView {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  ts        DateTime @default(now())
  referer   String   @default("")
  userAgent String   @default("") @map("user_agent")
  ipHash    String   @default("") @map("ip_hash")

  @@index([projectId, ts])
  @@map("project_views")
}

model Contact {
  id        String    @id @default(uuid())
  nombre    String
  email     String
  phone     String?
  empresa   String?
  proyecto  String?
  mensaje   String
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("contacts")
}

model CrmContact {
  id            String         @id @default(uuid())
  name          String
  email         String
  phone         String?
  company       String?
  source        String         @default("web")
  stage         String         @default("lead")
  value         Float          @default(0)
  notes         String         @default("")
  tags          String[]       @default([])
  lastContact   DateTime       @default(now()) @map("last_contact")
  createdAt     DateTime       @default(now()) @map("created_at")
  interactions  Interaction[]

  @@map("crm_contacts")
}

model Interaction {
  id        String    @id @default(uuid())
  contactId String
  contact   CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type      String
  date      DateTime  @default(now())
  summary   String    @default("")

  @@map("interactions")
}
model Campaign {
  id          String          @id @default(uuid())
  slug        String          @unique
  name        String
  description String          @default("")
  channel     String          @default("linkedin")
  status      String          @default("activa")
  targetUrl   String          @map("target_url")
  utmSource   String          @default("") @map("utm_source")
  utmMedium   String          @default("") @map("utm_medium")
  utmCampaign String          @default("") @map("utm_campaign")
  startDate   DateTime        @default(now()) @map("start_date")
  endDate     DateTime?       @map("end_date")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  clicks      CampaignClick[]

  @@map("campaigns")
}

model CampaignClick {
  id         String   @id @default(uuid())
  campaignId String   @map("campaign_id")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ts         DateTime @default(now())
  referer    String   @default("")
  userAgent  String   @default("") @map("user_agent")
  ipHash     String   @default("") @map("ip_hash")

  @@index([campaignId, ts])
  @@map("campaign_clicks")
}
